# nnh: jeden job, 8 rdzeni (trening sieci + XGB OOF, fity pass/fail)
Q          = /afs/cern.ch/user/k/klyczak/private/charm_q/Q_lxplus
universe   = vanilla
executable = /bin/bash
arguments  = $(Q)/nnh/nnh_job.sh
environment = "NNH_NPROC=8"
