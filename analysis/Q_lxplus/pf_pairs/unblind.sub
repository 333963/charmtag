# Węzeł DAG odsłonięcia (VARS step, cpus, mem, flavour z unblind.dag).
Q          = /afs/cern.ch/user/k/klyczak/private/charm_q/Q_lxplus
universe   = vanilla
executable = /bin/bash
arguments  = $(Q)/pf_pairs/unblind_job.sh $(step)
output     = $(Q)/logs/pf/unblind_$(step).$(ClusterId).out
error      = $(Q)/logs/pf/unblind_$(step).$(ClusterId).err
log        = $(Q)/logs/pf/unblind.log
request_cpus   = $(cpus)
request_memory = $(mem)
request_disk   = 4GB
+JobFlavour    = "$(flavour)"
should_transfer_files = NO
getenv     = False
queue
