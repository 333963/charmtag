# Węzeł DAG PAIR_PLANES (VARS step, part, np, cpus, mem, disk, flavour, penv z pp.dag).
Q          = /afs/cern.ch/user/k/klyczak/private/charm_q/Q_lxplus
universe   = vanilla
executable = /bin/bash
arguments  = $(Q)/pair_planes/pp_job.sh $(step) $(part) $(np)
output     = $(Q)/logs/pair_planes/pp_$(step)_$(part).$(ClusterId).out
error      = $(Q)/logs/pair_planes/pp_$(step)_$(part).$(ClusterId).err
log        = $(Q)/logs/pair_planes/pp.log
request_cpus   = $(cpus)
request_memory = $(mem)
request_disk   = $(disk)
+JobFlavour    = "$(flavour)"
should_transfer_files = NO
getenv     = False
environment = "$(penv)"
queue
