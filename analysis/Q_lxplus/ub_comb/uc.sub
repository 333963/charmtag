# Węzeł UBCOMB (VARS step, cpus, mem, flavour, penv).
Q          = /afs/cern.ch/user/k/klyczak/private/charm_q/Q_lxplus
universe   = vanilla
executable = /bin/bash
arguments  = $(Q)/ub_comb/uc_job.sh $(step)
output     = $(Q)/logs/ubcomb/uc_$(step).$(ClusterId).out
error      = $(Q)/logs/ubcomb/uc_$(step).$(ClusterId).err
log        = $(Q)/logs/ubcomb/uc.log
request_cpus   = $(cpus)
request_memory = $(mem)
request_disk   = 6GB
+JobFlavour    = "$(flavour)"
+JobBatchName  = "charm_ubcomb"
should_transfer_files = NO
getenv     = False
environment = "$(penv)"
queue
